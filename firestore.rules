rules_version = '2';

// Misael Barbearia — regras de segurança do Firestore
//
//  agendamentos/{id}  nome, telefone etc.   → ninguém lê, só o barbeiro (admin)
//  blocos/{dia_hora}  só dia + hora ocupada → leitura pública (mostra horários livres)
//  admins/{uid}       contas do barbeiro    → criado à mão no console do Firebase
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function docPath(col, id) {
      return /databases/$(database)/documents/$(col)/$(id);
    }

    // "2026-10-09" → data, para impedir agendamento no passado ou longe demais
    function dayOf(dia) {
      let p = dia.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }

    function validBooking(d) {
      return d.keys().hasOnly(['codigo', 'nome', 'telefone', 'obs', 'servicos', 'combo', 'total',
                               'duracao', 'dia', 'inicio', 'status', 'consentimento', 'criadoEm'])
        && d.keys().hasAll(['codigo', 'nome', 'telefone', 'obs', 'servicos', 'combo', 'total',
                            'duracao', 'dia', 'inicio', 'status', 'consentimento', 'criadoEm'])
        && d.codigo is string && d.codigo.matches('^MB-[A-Z0-9]{5}$')
        && d.nome is string && d.nome.matches("^[\\p{L}' .-]{3,60}$")
        && d.telefone is string && d.telefone.matches('^[0-9]{10,11}$')
        && d.obs is string && d.obs.size() <= 200
        && d.servicos is list && d.servicos.size() >= 1 && d.servicos.size() <= 3
        && d.servicos.hasOnly(['corte', 'barba', 'alisamento'])
        && (d.combo == null || d.combo in ['classico', 'liso', 'completo'])
        && d.total is int && d.total >= 30 && d.total <= 230
        // durações possíveis: serviços avulsos e combos (ver CONFIG em public/js/app.js)
        && d.duracao in [60, 75, 105, 120, 135, 165]
        && d.dia is string && d.dia.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && dayOf(d.dia) >= request.time - duration.value(1, 'd')
        && dayOf(d.dia) <= request.time + duration.value(35, 'd')
        && d.inicio is int && d.inicio >= 480 && d.inicio + d.duracao <= 1200 && d.inicio % 30 == 0
        && d.status == 'confirmado'
        && d.consentimento == true
        && d.criadoEm == request.time;
    }

    match /agendamentos/{id} {
      allow read, update, delete: if isAdmin();
      // só cria se, no mesmo lote, reservou o primeiro e o último bloco do horário
      allow create: if validBooking(request.resource.data)
        && existsAfter(docPath('blocos', request.resource.data.dia + '_' + string(request.resource.data.inicio)))
        && existsAfter(docPath('blocos', request.resource.data.dia + '_'
             + string(request.resource.data.inicio + request.resource.data.duracao - 15)));
    }

    match /blocos/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['dia', 'hora', 'ref'])
        && request.resource.data.hora is int
        && request.resource.data.ref is string
        && id == request.resource.data.dia + '_' + string(request.resource.data.hora)
        && coveredBy(request.resource.data);
      // bloco existente nunca é sobrescrito → impossível marcar horário em cima de outro
      allow update: if false;
      allow delete: if isAdmin();
    }

    function coveredBy(b) {
      let a = getAfter(docPath('agendamentos', b.ref)).data;
      return a.dia == b.dia
        && b.hora >= a.inicio
        && b.hora < a.inicio + a.duracao
        && (b.hora - a.inicio) % 15 == 0;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
